# =============================================================================
# SWBM — environment variables (TEMPLATE — do not commit real secrets)
# =============================================================================
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# listed in `.gitignore` so it will never be committed.
#
# Where to find each value:
#   NEXT_PUBLIC_SUPABASE_URL                Supabase dashboard → Project → API
#   NEXT_PUBLIC_SUPABASE_ANON_KEY           Supabase dashboard → Project → API
#   SUPABASE_SERVICE_ROLE_KEY               Supabase dashboard → Project → API
#   SUPABASE_PUBLISHABLE_KEY               Supabase dashboard → Project → API (new key format)
#   SUPABASE_SECRET_KEY                     Supabase dashboard → Project → API (new key format)
#   SUPABASE_JWT_SECRET                     Supabase dashboard → Project → API
#   POSTGRES_*                              Supabase dashboard → Project → Database
#   RESEND_API_KEY                          https://resend.com/api-keys (or Settings → Integrations)
#   RESEND_FROM_ADDRESS                     Your Name <noreply@yourdomain.com> (or Settings → Integrations)
#   GOADDRESS_TOKEN                         https://portal.goaddress.io (recommended; or Settings → Integrations)
#   GEOAPIFY_API_KEY                        https://myprojects.geoapify.com/projects (deprecated, no longer used)
#
# `NEXT_PUBLIC_*` values are exposed to the browser. Everything else is
# server-only. Never put a real key behind `NEXT_PUBLIC_` unless you
# are 100% sure it is safe to ship to the client.
# =============================================================================

# --- Supabase (project URL + publishable / secret keys) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...replace-me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...replace-me

# Optional new-format keys (Supabase is rolling these out alongside the
# legacy JWT keys above). You can copy them from the same API page.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...replace-me
SUPABASE_SECRET_KEY=sb_secret_...replace-me
SUPABASE_JWT_SECRET=...replace-me

# --- App --------------------------------------------------------------------
# The canonical base URL of the deployed app. Used for outbound auth
# emails (password reset, etc.) and share/invite links. Set this to your
# production domain (e.g. https://starhawkbm.com) so emails point
# customers back to the right URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator sign-in URL path. Kept off the default /login route so
# drive-by scanners don't find the staff sign-in form. Configurable so
# it can be rotated without a code change and (more importantly) so
# the literal string doesn't have to live in source control under a
# developer's personal name.
#
# Lookup order (first non-empty wins):
#   1. ADMIN_LOGIN_PATH             — server-only override
#   2. NEXT_PUBLIC_ADMIN_LOGIN_PATH — exposed to the browser bundle
#      (NEXT_PUBLIC_ vars are inlined into client JS at build time)
#   3. '/admin-login'               — safe neutral default
#
# Must start with '/'. Anything without a leading slash is normalised
# by the app. The Next.js rewrite rule maps this path to /admin-login
# (a plain-ASCII folder name — Next.js reserves @folder names for
# parallel route slots).
# ADMIN_LOGIN_PATH=/staff-sign-in
# NEXT_PUBLIC_ADMIN_LOGIN_PATH=/staff-sign-in

# --- Postgres (only used by the seed / migration scripts, not the app) ----
POSTGRES_HOST=db.YOUR-PROJECT-REF.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=...replace-me
POSTGRES_URL=postgres://postgres.YOUR-PROJECT-REF:...@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://postgres.YOUR-PROJECT-REF:...@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.YOUR-PROJECT-REF:...@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# --- Outbound email (Resend) ----------------------------------------------
# Get the API key at https://resend.com/api-keys
# The from address must be on a domain you've verified in Resend, or
# use the sandbox onboarding@resend.dev for testing.
#
# These values can also be managed from Settings → Integrations in the
# dashboard. Values saved there take priority; env vars are fallbacks.
RESEND_API_KEY=re_...replace-me
RESEND_FROM_ADDRESS=Your Name <noreply@yourdomain.com>

# --- Address autocomplete (deprecated) -----------------------------------
# Geoapify was previously used for free-text address autocomplete. The app now
# uses GoAddress postcode lookup (below). Leave these blank unless you are
# maintaining legacy code.
# GEOAPIFY_API_KEY=...replace-me
# GEOAPIFY_FILTER=countrycode:gb

# --- AI invoice assistant (DeepSeek) ---------------------------------------
# The API key is NOT configured here — it lives in the dashboard under
# Settings → AI and is stored AES-256-GCM encrypted in the
# invoice_assistant_api_key table. Rotating the key there takes effect on
# the next assistant turn without a redeploy.
#
# Get a key at https://platform.deepseek.com/api_keys
#
# DEEPSEEK_MODEL is still honoured as a server-wide default when no model
# is configured in Settings → AI. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash

# Encryption passphrase for secrets saved in Settings → Integrations
# (Resend, Turnstile, GoAddress) and the invoice assistant.
# Either name works; this project commonly uses AI_DESIGNER_KEY_ENCRYPTION_KEY
# on Vercel. ENCRYPTION_KEY is an alternate preferred name for new deploys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Treat this value as a secret. Rotating it alone breaks decrypt until secrets
# are re-saved, unless you also set ENCRYPTION_KEY_PREVIOUS (see below).
# AI_DESIGNER_KEY_ENCRYPTION_KEY=replace-with-a-long-random-string
# ENCRYPTION_KEY=replace-with-a-long-random-string
#
# After rotating the passphrase, set this to the *old* value so existing
# encrypted rows still decrypt. Re-save each secret in Settings, then remove it.
# ENCRYPTION_KEY_PREVIOUS=previous-encryption-key-value

# --- Postcode lookup (recommended) ---------------------------------------
# Sign up at https://portal.goaddress.io and grab the bearer token. This
# populates the postcode-to-address dropdown in client and invoice forms.
# If unset, the app falls back to the free postcodes.io endpoint (postcode
# metadata only, no per-address list).
#
# This token can also be saved in Settings → Integrations. The dashboard
# value takes priority; this env var is the fallback.
GOADDRESS_TOKEN=...replace-me

# --- Search engine verification -------------------------------------------
# Google Search Console: https://search.google.com/search-console
# Add your property → choose "HTML tag" verification → copy the content
# value (the long random string inside content="...").
# Bing Webmaster Tools: https://www.bing.com/webmasters → verify ownership
# → copy the content value for <meta name="msvalidate.01" />.
# Leave either blank to skip emitting that meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=...replace-me
# NEXT_PUBLIC_BING_SITE_VERIFICATION=...replace-me

# --- Analytics ------------------------------------------------------------
# Google Analytics 4 measurement ID (starts with G-). The script is only
# emitted when this value is set. Get it from
# https://analytics.google.com → Admin → Data Streams.
# Leave blank to disable analytics entirely.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Cloudflare Turnstile CAPTCHA -----------------------------------------
# Sign up at https://dash.cloudflare.com/turnstile → add a widget → copy keys.
# The site key is public and shipped to the browser. The secret key stays
# server-side and is used to verify tokens.
#
# Both keys can also be managed from Settings → Integrations. Dashboard
# values take priority; these env vars are fallbacks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Vercel Cron ----------------------------------------------------------
# Shared secret used to protect /api/cron/* endpoints. Vercel sends this
# in the Authorization header automatically. Generate a strong random value
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=replace-with-a-long-random-string

# --- Deployment toggles ----------------------------------------------------
# Set to "1" only when the app sits behind a reverse proxy (Vercel,
# Cloudflare, nginx, etc.) that strips/sanitises x-forwarded-* headers.
# Leave unset on bare deployments — trusting these headers from the
# open internet lets attackers spoof the public URL.
# TRUST_PROXY=1

# Set to "true" when deploying to a non-Node / non-Vercel target that
# does not support Next.js Image Optimization. Vercel supports it; most
# other platforms do too. Only enable for static exports.
# IMAGES_UNOPTIMIZED=true

# --- Demo mode (Demo Builder Merchant sales demo) ---------------------------
# Set to true on the dedicated demo deployment only. When true, fallback
# brand strings and metadata use Demo Builder Merchant instead of Star Hawk.
# NEXT_PUBLIC_DEMO_MODE=true
# DEMO_MODE=true
# Industry pack for landing presentation: construction | plumbing | electrical | windows | tile
# NEXT_PUBLIC_DEMO_VERTICAL=construction
# DEMO_VERTICAL=construction
# Required safety gate for wipe/seed scripts (must equal yes):
# DEMO_SEED_CONFIRM=yes
