# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/

# production
/build

# temporary directories created by ad-hoc scripts
/.tmp/

# runtime backup of default brand assets; recreated on first logo upload
/public/_default-logo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is checked in.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / backups (anchored to repo root so app/tools/ and any
# other nested "tools" or "legacy" folder — e.g. the public tools hub at
# app/tools/ — are NOT ignored).
/tools/
/legacy/

# local dev logs
dev.*.log
dev.*.log.err

# scratch / debug artifacts (.tmp_*) — created by ad-hoc scripts and
# never meant to be committed. Add this pattern globally so future
# throwaway files don't pollute `git status`.
.tmp_*

# vendored python runtime + helpers (PDF tooling lives outside Next.js)
/lib/site-packages/
/lib/__pycache__/
/lib/*.pyc
/scripts/*.exe
/scripts/*.pyd
/scripts/__pycache__/

# local AI tooling
.kimi/

